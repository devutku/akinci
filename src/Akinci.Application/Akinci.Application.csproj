<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Akinci.Domain\Akinci.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Paketleme ve Lisanslama -->
    <PackageId>Akinci.Application</PackageId>
    <Version>1.0.1</Version>
    <Authors>Utku Berki Baysal</Authors>
    <Company>Akıncı</Company>
    <Description>Akıncı Çok Kanallı İndirme Motoru uygulama portları, DTO'ları ve use case orkestrasyonu.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/devutku/akinci</PackageProjectUrl>
    <RepositoryUrl>https://github.com/devutku/akinci.git</RepositoryUrl>
    <PackageTags>download-manager;downloader;chunk;resilient;application</PackageTags>
  </PropertyGroup>

</Project>
