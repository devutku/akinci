{
  "manifest_version": 3,
  "name": "Akıncı Downloader Entegrasyonu",
  "version": "1.0.0",
  "description": "Bağlantıları ve indirmeleri otomatik olarak Akıncı Çok Kanallı İndirme Motoruna aktarır.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:49500/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Akıncı Downloader",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
