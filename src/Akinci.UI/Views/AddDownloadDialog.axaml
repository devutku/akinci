<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Akinci.UI.ViewModels"
        x:Class="Akinci.UI.Views.AddDownloadDialog"
        x:DataType="vm:AddDownloadDialogViewModel"
        Title="Yeni İndirme Ekle - AKINCI"
        Icon="/Assets/akinci.ico"
        Width="580" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1E1E2E">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#313244" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="BorderBrush" Value="#45475A" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Window.Styles>

    <Border Padding="24">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
                <Border Grid.Column="0" CornerRadius="8" Width="44" Height="44" ClipToBounds="True" Background="#181825" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Image Source="avares://Akinci.UI/Assets/akinci-logo-dark.svg" Width="44" Height="44" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Yeni İndirme Görevi" FontSize="18" FontWeight="Bold" Foreground="#89B4FA" />
                    <TextBlock Text="HTTP, HTTPS, FTP veya FTPS bağlantısı girin." FontSize="12" Foreground="#A6ADC8" />
                </StackPanel>
            </Grid>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="6">
                    <TextBlock Text="İndirme Bağlantısı (URL)*" Classes="label" />
                    <TextBox Text="{Binding Url}" PlaceholderText="https:// veya ftp://..." />

                    <TextBlock Text="Kayıt Dizini" Classes="label" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding DestinationDirectory}" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="Seç..." Click="OnBrowseFolderClick"
                                Background="#45475A" Foreground="#CDD6F4" CornerRadius="6" Padding="12,8" />
                    </Grid>

                    <TextBlock Text="Özel Dosya Adı (İsteğe bağlı)" Classes="label" />
                    <TextBox Text="{Binding CustomFileName}" PlaceholderText="Örn: ubuntu-desktop.iso (Boş bırakılırsa otomatik bulunur)" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <TextBlock Grid.Column="0" Text="Paralel Bağlantı Sayısı (Parça)" Classes="label" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Connections}" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center" />
                    </Grid>
                    <Slider Minimum="1" Maximum="32" Value="{Binding Connections}" IsSnapToTickEnabled="True" TickFrequency="1" />

                    <!-- Kimlik Doğrulama Bölümü -->
                    <Border Background="#28283D" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Kimlik Doğrulama (Opsiyonel)" FontWeight="Bold" Foreground="#CBA6F7" />
                            <ComboBox ItemsSource="{Binding AvailableAuthTypes}" SelectedItem="{Binding SelectedAuthType}"
                                      HorizontalAlignment="Stretch" Background="#313244" Foreground="#CDD6F4" CornerRadius="6" />

                            <StackPanel IsVisible="{Binding IsAuthRequired}" Spacing="6" Margin="0,8,0,0">
                                <CheckBox Content="Mevcut Windows oturum bilgilerini kullan"
                                          IsChecked="{Binding UseDefaultCredentials}" Foreground="#CDD6F4" />

                                <StackPanel IsVisible="{Binding !UseDefaultCredentials}" Spacing="6">
                                    <TextBlock Text="Kullanıcı Adı" Classes="label" />
                                    <TextBox Text="{Binding UserName}" PlaceholderText="Kullanıcı adı" />

                                    <TextBlock Text="Parola" Classes="label" />
                                    <TextBox Text="{Binding Password}" PasswordChar="●" PlaceholderText="Parola" />

                                    <StackPanel IsVisible="{Binding ShowDomainField}">
                                        <TextBlock Text="Windows Domain" Classes="label" />
                                        <TextBox Text="{Binding Domain}" PlaceholderText="Domain adı (Opsiyonel)" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
                <Button Content="İptal" Click="OnCancelClick"
                        Background="#313244" Foreground="#CDD6F4" CornerRadius="6" Padding="16,8" />
                <Button Content="İndirmeyi Başlat" Click="OnSubmitClick"
                        Background="#89B4FA" Foreground="#1E1E2E" FontWeight="Bold" CornerRadius="6" Padding="16,8" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
