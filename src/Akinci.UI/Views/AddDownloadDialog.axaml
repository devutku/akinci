<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Akinci.UI.ViewModels"
        x:Class="Akinci.UI.Views.AddDownloadDialog"
        x:DataType="vm:AddDownloadDialogViewModel"
        Title="Yeni İndirme Ekle - AKINCI"
        Icon="/Assets/akinci.ico"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#0F0F12">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Margin" Value="0,6,0,3" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#18181C" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#272730" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#38BDF8" />
        </Style>
        <Style Selector="Button.quiet-btn">
            <Setter Property="Background" Value="#272730" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.quiet-btn:pointerover">
            <Setter Property="Background" Value="#353542" />
        </Style>
        <Style Selector="Button.primary-action-btn">
            <Setter Property="Background" Value="#38BDF8" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primary-action-btn:pointerover">
            <Setter Property="Background" Value="#7DD3FC" />
        </Style>
    </Window.Styles>

    <Border Padding="22,18">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header (Strict Contrast: Clean Logo & Typography) -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                <Border Grid.Column="0" CornerRadius="6" Width="38" Height="38" ClipToBounds="True" Background="#18181C" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Image Source="/Assets/akinci-logo.png" Width="38" Height="38" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Yeni İndirme Görevi" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="HTTP, HTTPS, FTP veya FTPS bağlantısı girin." FontSize="11" Foreground="#64748B" />
                </StackPanel>
            </Grid>

            <!-- Form Content (No Scrollbar, Clean Fit) -->
            <StackPanel Grid.Row="1" Spacing="5">
                <TextBlock Text="İndirme Bağlantısı (URL)*" Classes="label" />
                <TextBox Text="{Binding Url}" PlaceholderText="https:// veya ftp://..." />

                <TextBlock Text="Kayıt Dizini" Classes="label" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding DestinationDirectory}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Seç..." Click="OnBrowseFolderClick" Classes="quiet-btn" Padding="12,7" />
                </Grid>

                <TextBlock Text="Özel Dosya Adı (İsteğe bağlı)" Classes="label" />
                <TextBox Text="{Binding CustomFileName}" PlaceholderText="Örn: ubuntu-desktop.iso (Boş bırakılırsa otomatik bulunur)" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBlock Grid.Column="0" Text="Paralel Bağlantı Sayısı (Parça)" Classes="label" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Connections}" FontWeight="Bold" Foreground="#38BDF8" FontSize="13" VerticalAlignment="Center" />
                </Grid>
                <Slider Minimum="1" Maximum="32" Value="{Binding Connections}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,2,0,4" />

                <!-- Kimlik Doğrulama Kartı (Quiet #18181C) -->
                <Border Background="#18181C" BorderBrush="#22222A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,6,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Kimlik Doğrulama (Opsiyonel)" FontWeight="SemiBold" FontSize="12" Foreground="#94A3B8" />
                        <ComboBox ItemsSource="{Binding AvailableAuthTypes}" SelectedItem="{Binding SelectedAuthType}"
                                  HorizontalAlignment="Stretch" Background="#18181C" Foreground="#F8FAFC" BorderBrush="#272730" CornerRadius="5" />

                        <StackPanel IsVisible="{Binding IsAuthRequired}" Spacing="6" Margin="0,6,0,0">
                            <CheckBox Content="Mevcut Windows oturum bilgilerini kullan"
                                      IsChecked="{Binding UseDefaultCredentials}" Foreground="#94A3B8" FontSize="11" />

                            <StackPanel IsVisible="{Binding !UseDefaultCredentials}" Spacing="6">
                                <TextBlock Text="Kullanıcı Adı" Classes="label" />
                                <TextBox Text="{Binding UserName}" PlaceholderText="Kullanıcı adı" />

                                <TextBlock Text="Parola" Classes="label" />
                                <TextBox Text="{Binding Password}" PasswordChar="●" PlaceholderText="Parola" />

                                <StackPanel IsVisible="{Binding ShowDomainField}">
                                    <TextBlock Text="Windows Domain" Classes="label" />
                                    <TextBox Text="{Binding Domain}" PlaceholderText="Domain adı (Opsiyonel)" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Actions Footer (Quiet Gray Cancel, Sole Cyan Submit) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
                <Button Content="İptal" Click="OnCancelClick" Classes="quiet-btn" />
                <Button Content="İndirmeyi Başlat" Click="OnSubmitClick" Classes="primary-action-btn" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
