<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Akinci.UI.ViewModels"
        x:Class="Akinci.UI.Views.SettingsDialog"
        x:DataType="vm:SettingsDialogViewModel"
        Title="Ayarlar - AKINCI"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1E1E2E">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#313244" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="BorderBrush" Value="#45475A" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Window.Styles>

    <Border Padding="24">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Uygulama Ayarları" FontSize="20" FontWeight="Bold" Foreground="#89B4FA" />
                <TextBlock Text="İndirme tercihlerinizi ve VirusTotal entegrasyonunu yapılandırın." FontSize="12" Foreground="#A6ADC8" />
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1" Spacing="10">
                <TextBlock Text="Varsayılan Kayıt Dizini" Classes="label" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding DefaultDirectory}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Seç..." Click="OnBrowseFolderClick"
                            Background="#45475A" Foreground="#CDD6F4" CornerRadius="6" Padding="12,8" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBlock Grid.Column="0" Text="Varsayılan Bağlantı / Parça Sayısı" Classes="label" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding DefaultConnections}" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center" />
                </Grid>
                <Slider Minimum="1" Maximum="32" Value="{Binding DefaultConnections}" IsSnapToTickEnabled="True" TickFrequency="1" />

                <!-- VirusTotal Kartı -->
                <Border Background="#28283D" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="🛡 VirusTotal API Entegrasyonu" FontWeight="Bold" Foreground="#A6E3A1" />
                        <TextBlock Text="İndirilen dosyaların 70+ antivirüs motoru ile taranması için API anahtarınızı girin."
                                   FontSize="11" Foreground="#A6ADC8" TextWrapping="Wrap" />
                        <TextBox Text="{Binding VirusTotalApiKey}" PasswordChar="●" PlaceholderText="VirusTotal API Key (64 karakter)" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
                <Button Content="İptal" Click="OnCancelClick"
                        Background="#313244" Foreground="#CDD6F4" CornerRadius="6" Padding="16,8" />
                <Button Content="Kaydet" Click="OnSaveClick"
                        Background="#89B4FA" Foreground="#1E1E2E" FontWeight="Bold" CornerRadius="6" Padding="16,8" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
