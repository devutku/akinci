<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Akinci.UI.ViewModels"
        xmlns:l="using:Akinci.UI.Localization"
        x:Class="Akinci.UI.Views.SettingsDialog"
        x:DataType="vm:SettingsDialogViewModel"
        Title="{x:Static l:Strings.SettingsDialogTitle}"
        Icon="/Assets/akinci.ico"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#0F0F12">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Margin" Value="0,6,0,3" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#18181C" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#272730" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#38BDF8" />
        </Style>
        <Style Selector="Button.quiet-btn">
            <Setter Property="Background" Value="#272730" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.quiet-btn:pointerover">
            <Setter Property="Background" Value="#353542" />
        </Style>
        <Style Selector="Button.primary-action-btn">
            <Setter Property="Background" Value="#38BDF8" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primary-action-btn:pointerover">
            <Setter Property="Background" Value="#7DD3FC" />
        </Style>
    </Window.Styles>

    <Border Padding="22,18">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header (Strict Contrast: Clean Logo & Typography) -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                <Border Grid.Column="0" CornerRadius="6" Width="38" Height="38" ClipToBounds="True" Background="#18181C" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Image Source="/Assets/akinci-logo.png" Width="38" Height="38" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Static l:Strings.SettingsHeader}" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="{x:Static l:Strings.SettingsSubheader}" FontSize="11" Foreground="#64748B" />
                </StackPanel>
            </Grid>

            <!-- Form Content: ekran yüksekliğine sığmazsa kaydırılır; başlık ve alt düğmeler sabit kalır -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="6" Margin="0,0,10,0">
                <TextBlock Text="{x:Static l:Strings.LanguageLabel}" Classes="label" />
                <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}"
                          HorizontalAlignment="Stretch" Background="#18181C" Foreground="#F8FAFC" BorderBrush="#272730" CornerRadius="5">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LanguageOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{x:Static l:Strings.LanguageRestartHint}" FontSize="11" Foreground="#64748B"
                           TextWrapping="Wrap" IsVisible="{Binding IsLanguageChanged}" />

                <TextBlock Text="{x:Static l:Strings.DefaultDirectoryLabel}" Classes="label" Margin="0,8,0,3" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding DefaultDirectory}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="{x:Static l:Strings.Browse}" Click="OnBrowseFolderClick" Classes="quiet-btn" Padding="12,7" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.DefaultConnectionsLabel}" Classes="label" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding DefaultConnections}" FontWeight="Bold" Foreground="#38BDF8" FontSize="13" VerticalAlignment="Center" />
                </Grid>
                <Slider Minimum="1" Maximum="32" Value="{Binding DefaultConnections}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,2,0,4" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.MaxConcurrentLabel}" Classes="label" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding MaxConcurrentDownloads}" FontWeight="Bold" Foreground="#38BDF8" FontSize="13" VerticalAlignment="Center" />
                </Grid>
                <Slider Minimum="1" Maximum="10" Value="{Binding MaxConcurrentDownloads}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,2,0,4" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.SpeedLimitLabel}" Classes="label" VerticalAlignment="Center" />
                </Grid>
                <TextBox Text="{Binding SpeedLimitKbps}" PlaceholderText="{x:Static l:Strings.SpeedLimitPlaceholder}" />

                <!-- Akıllı Pano İzleyici Kartı -->
                <Border Background="#18181C" BorderBrush="#22222A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,6,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static l:Strings.ClipboardTitle}" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                            <TextBlock Text="{x:Static l:Strings.ClipboardDescription}"
                                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableClipboardMonitor}" OnContent="" OffContent="" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- VirusTotal Kartı (Strict Monochrome) -->
                <Border Background="#18181C" BorderBrush="#22222A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,6,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Static l:Strings.VirusTotalTitle}" FontWeight="SemiBold" FontSize="12" Foreground="#34D399" />
                        <TextBlock Text="{x:Static l:Strings.VirusTotalDescription}"
                                   FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                        <TextBox Text="{Binding VirusTotalApiKey}" PasswordChar="●" PlaceholderText="{x:Static l:Strings.VirusTotalPlaceholder}" />
                    </StackPanel>
                </Border>

                <!-- Tarayıcı Entegrasyonu Kartı -->
                <Border Background="#18181C" BorderBrush="#22222A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,6,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static l:Strings.ExtensionTitle}" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                            <TextBlock Text="{x:Static l:Strings.ExtensionDescription}"
                                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{x:Static l:Strings.InstallExtensionButton}" Click="OnInstallExtensionClick" Classes="quiet-btn" Padding="12,7" Margin="8,0,0,0" />
                    </Grid>
                </Border>

                <!-- Akıncı Hakkında & Hero Banner Card -->
                <Border Background="#18181C" BorderBrush="#22222A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                    <Grid RowDefinitions="Auto,Auto">
                        <Border Grid.Row="0" CornerRadius="4" ClipToBounds="True" Height="100" Margin="0,0,0,8">
                            <Image Source="/Assets/akinci-banner.jpg" Stretch="UniformToFill" />
                        </Border>

                        <StackPanel Grid.Row="1" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" x:Name="TxtVersion" Text="{x:Static l:Strings.AboutName}" FontWeight="SemiBold" FontSize="12" Foreground="#F8FAFC" />
                                <TextBlock Grid.Column="1" Text=".NET 10 • Clean Core" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                            </Grid>
                            <TextBlock Text="{x:Static l:Strings.AboutDescription}"
                                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <!-- Actions Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
                <Button Content="{x:Static l:Strings.Cancel}" Click="OnCancelClick" Classes="quiet-btn" />
                <Button Content="{x:Static l:Strings.Save}" Click="OnSaveClick" Classes="primary-action-btn" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
