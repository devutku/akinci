<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Akinci.UI.ViewModels"
        x:Class="Akinci.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AKINCI - İndirme Yöneticisi"
        Icon="/Assets/akinci.ico"
        Width="1080" Height="680"
        MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="BorderOnly"
        Background="#0F0F12">

    <Window.Resources>
        <!-- Lucide / Fluent Style Monochromatic Geometries -->
        <StreamGeometry x:Key="IconInbox">M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zm0 9.5V18h16v-4.5h-4c0 1.66-1.34 3-3 3s-3-1.34-3-3H4z</StreamGeometry>
        <StreamGeometry x:Key="IconDownload">M12 3v11m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2</StreamGeometry>
        <StreamGeometry x:Key="IconPause">M7 4h3.5v16H7zm6.5 0h3.5v16h-3.5z</StreamGeometry>
        <StreamGeometry x:Key="IconCheck">M20 6L9 17l-5-5</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zm10 2l-4.35-4.35</StreamGeometry>
        <StreamGeometry x:Key="IconPauseAll">M7 4h3v16H7zm7 0h3v16h-3z</StreamGeometry>
        <StreamGeometry x:Key="IconResumeAll">M5 3l14 9-14 9V3z</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm7.4-2.8l1.7 1.3-1.6 2.8-2-.8a7 7 0 0 1-1.4.8l-.3 2.1h-3.2l-.3-2.1a7 7 0 0 1-1.4-.8l-2 .8-1.6-2.8 1.7-1.3a7.3 7.3 0 0 1 0-1.6l-1.7-1.3 1.6-2.8 2 .8a7 7 0 0 1 1.4-.8l.3-2.1h3.2l.3 2.1a7 7 0 0 1 1.4.8l2-.8 1.6 2.8-1.7 1.3c.1.5.1 1.1 0 1.6z</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M3 6a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6z</StreamGeometry>
        <StreamGeometry x:Key="IconTrash">M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14z</StreamGeometry>
        <StreamGeometry x:Key="IconFile">M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6</StreamGeometry>
        <StreamGeometry x:Key="IconShield">M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z</StreamGeometry>
        <StreamGeometry x:Key="IconMinimize">M4 11h16v2H4z</StreamGeometry>
        <StreamGeometry x:Key="IconMaximize">M4 4h16v16H4V4zm2 2v12h12V6H6z</StreamGeometry>
        <StreamGeometry x:Key="IconClose">M18.3 5.71a1 1 0 0 0-1.42 0L12 10.59 7.12 5.7a1 1 0 0 0-1.41 1.42L10.59 12l-4.88 4.88a1 1 0 1 0 1.41 1.42L12 13.41l4.88 4.89a1 1 0 0 0 1.42-1.42L13.41 12l4.89-4.88a1 1 0 0 0 0-1.41z</StreamGeometry>
        <StreamGeometry x:Key="IconRestart">M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67</StreamGeometry>
        <StreamGeometry x:Key="IconCopy">M9 9h13v13H9z M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1</StreamGeometry>
        <StreamGeometry x:Key="IconHash">M4 9h16M4 15h16M10 3L8 21M16 3l-2 18</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <!-- Nav Item Button (Strict contrast: #18181C base, #1C2430 selected) -->
        <Style Selector="Button.nav-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Background" Value="#1C1C22" />
            <Setter Property="Foreground" Value="#F8FAFC" />
        </Style>
        <Style Selector="Button.nav-item.selected">
            <Setter Property="Background" Value="#1C2430" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
        </Style>

        <!-- Quiet Gray Toolbar Buttons (Frameless #272730, crisp white text/icons) -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="#272730" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.icon-btn:pointerover">
            <Setter Property="Background" Value="#353542" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Frameless Window Control Buttons -->
        <Style Selector="Button.window-control-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.window-control-btn:pointerover">
            <Setter Property="Background" Value="#272730" />
            <Setter Property="Foreground" Value="#F8FAFC" />
        </Style>
        <Style Selector="Button.window-close-btn:pointerover">
            <Setter Property="Background" Value="#E11D48" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Sole Highlighted Cyan Accent Button (#38BDF8) -->
        <Style Selector="Button.primary-action-btn">
            <Setter Property="Background" Value="#38BDF8" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primary-action-btn:pointerover">
            <Setter Property="Background" Value="#7DD3FC" />
        </Style>

        <!-- Download List Item Row (Strict Contrast: #18181C cards on #0F0F12 body) -->
        <Style Selector="Border.download-row">
            <Setter Property="Background" Value="#18181C" />
            <Setter Property="BorderBrush" Value="#22222A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.download-row:pointerover">
            <Setter Property="Background" Value="#202026" />
            <Setter Property="BorderBrush" Value="#2E2E38" />
        </Style>

        <!-- Action Buttons (Clear, crisp desktop buttons) -->
        <Style Selector="Border.download-row Button.row-action">
            <Setter Property="Opacity" Value="0.9" />
            <Setter Property="Background" Value="#202026" />
            <Setter Property="BorderBrush" Value="#2B2B36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.download-row Button.row-action:pointerover">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="#2C2C38" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
        </Style>

        <!-- Primary Action Buttons (Pause & Resume: Highlighted, prominent blue theme) -->
        <Style Selector="Border.download-row Button.row-action-primary">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="#162A3B" />
            <Setter Property="BorderBrush" Value="#1E4466" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.download-row Button.row-action-primary:pointerover">
            <Setter Property="Background" Value="#1E3E5B" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Top Application TitleBar / Toolbar (Frameless, Window Draggable, Mica/Acrylic Feel) -->
        <Border Grid.Row="0" Background="#131317" BorderBrush="#1E1E24" BorderThickness="0,0,0,1"
                Padding="16,7,8,7" PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Brand Logo & Integrated Quiet Search Box -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Image Source="/Assets/akinci-logo.png" Width="22" Height="22" VerticalAlignment="Center" />
                        <TextBlock Text="AKINCI" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" LetterSpacing="0.8" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Integrated Search Box (Quiet dark #18181C) -->
                    <TextBox x:Name="SearchInputBox" Text="{Binding SearchQuery}" PlaceholderText="Filtrele veya ara (Ctrl+F)..."
                             Width="210" Height="28" VerticalContentAlignment="Center"
                             Background="#18181C" Foreground="#F8FAFC" BorderBrush="#272730" CornerRadius="5" Padding="8,0" FontSize="12">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource IconSearch}" Width="12" Height="12" Foreground="#64748B" Margin="6,0,0,0" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                </StackPanel>

                <!-- Center: Calm, Unboxed Desktop Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="↓" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalSpeedText}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="•" Foreground="#272730" FontSize="12" Margin="4,0" VerticalAlignment="Center" />
                    <TextBlock Text="Aktif:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActiveCount}" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="•" Foreground="#272730" FontSize="12" Margin="4,0" VerticalAlignment="Center" />
                    <TextBlock Text="Biten:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CompletedCount}" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Quiet Buttons, Accent Action + Integrated Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Command="{Binding PauseAllCommand}" Classes="icon-btn" ToolTip.Tip="Tümünü Duraklat">
                        <PathIcon Data="{StaticResource IconPauseAll}" Width="12" Height="12" Foreground="#F8FAFC" />
                    </Button>
                    <Button Command="{Binding ResumeAllCommand}" Classes="icon-btn" ToolTip.Tip="Tümünü Başlat">
                        <PathIcon Data="{StaticResource IconResumeAll}" Width="12" Height="12" Foreground="#F8FAFC" />
                    </Button>
                    <Button Click="OnSettingsClick" Classes="icon-btn" ToolTip.Tip="Ayarlar">
                        <PathIcon Data="{StaticResource IconSettings}" Width="12" Height="12" Foreground="#F8FAFC" />
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="#272730" Margin="4,0" VerticalAlignment="Center" />

                    <!-- Single Clean Highlighted Button (#38BDF8) -->
                    <Button Content="+ İndirme Ekle" Click="OnAddDownloadClick" Classes="primary-action-btn" />

                    <Rectangle Width="1" Height="16" Fill="#272730" Margin="4,0" VerticalAlignment="Center" />

                    <!-- Frameless Window Controls (Minimize, Maximize, Close) -->
                    <Button Click="OnMinimizeClick" Classes="window-control-btn" ToolTip.Tip="Simge Durumuna Küçült">
                        <PathIcon Data="{StaticResource IconMinimize}" Width="12" Height="12" Foreground="#CBD5E1" />
                    </Button>
                    <Button Click="OnMaximizeClick" Classes="window-control-btn" ToolTip.Tip="Büyüt / Önceki Boyut">
                        <PathIcon Data="{StaticResource IconMaximize}" Width="11" Height="11" Foreground="#CBD5E1" />
                    </Button>
                    <Button Click="OnCloseClick" Classes="window-control-btn window-close-btn" ToolTip.Tip="Kapat (Arka Plana Al)">
                        <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" Foreground="#CBD5E1" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Sidebar + Content Area -->
        <Grid Grid.Row="1" ColumnDefinitions="190,*">
            <!-- Left Sidebar Navigation (Strict Contrast: #131317 background, #1E1E24 border) -->
            <Border Grid.Column="0" Background="#131317" BorderBrush="#1E1E24" BorderThickness="0,0,1,0" Padding="10,12">
                <StackPanel Spacing="3">
                    <TextBlock Text="İNDİRMELER" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="10,2,0,6" />

                    <!-- Tümü -->
                    <Button Click="OnFilterClicked" Tag="Tümü" Classes="nav-item" Classes.selected="{Binding IsAllSelected}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconInbox}" Width="14" Height="14" />
                                <TextBlock Text="Tümü" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding TotalCount}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- İndirilenler -->
                    <Button Click="OnFilterClicked" Tag="İndirilenler" Classes="nav-item" Classes.selected="{Binding IsDownloadingSelected}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconDownload}" Width="14" Height="14" />
                                <TextBlock Text="İndirilenler" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding ActiveCount}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Duraklatılanlar -->
                    <Button Click="OnFilterClicked" Tag="Duraklatılanlar" Classes="nav-item" Classes.selected="{Binding IsPausedSelected}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconPause}" Width="14" Height="14" />
                                <TextBlock Text="Duraklatılanlar" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Tamamlananlar -->
                    <Button Click="OnFilterClicked" Tag="Tamamlananlar" Classes="nav-item" Classes.selected="{Binding IsCompletedSelected}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" />
                                <TextBlock Text="Tamamlananlar" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding CompletedCount}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Right Content Area -->
            <Grid Grid.Column="1">
                <!-- Clean, Restrained Empty State -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                            IsVisible="{Binding !FilteredDownloads.Count}">
                    <Image Source="/Assets/akinci-logo.png" Width="64" Height="64" Opacity="0.55" HorizontalAlignment="Center" />
                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                        <TextBlock Text="Henüz bir indirme eklenmedi" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#CBD5E1" HorizontalAlignment="Center" />
                        <TextBlock Text="Bağlantı yapıştırmak için Ctrl + V tuşlarına basın veya yukarıdan '+ İndirme Ekle'ye tıklayın."
                                   FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Downloads List View -->
                <ScrollViewer Padding="16">
                    <ItemsControl ItemsSource="{Binding FilteredDownloads}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                <!-- Modern Desktop Download Row (Linear / GitHub Desktop / qBittorrent Style) -->
                                <Border Classes="download-row" DoubleTapped="OnRowDoubleTapped">
                                    <Border.ContextMenu>
                                        <ContextMenu Background="#18181C" BorderBrush="#272730" BorderThickness="1" CornerRadius="6">
                                            <MenuItem Header="Dosyayı Aç" Command="{Binding OpenFileCommand}" IsVisible="{Binding IsCompleted}">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource IconFile}" Width="12" Height="12" Foreground="#38BDF8" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Klasörde Göster" Command="{Binding OpenFolderCommand}">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource IconFolder}" Width="12" Height="12" Foreground="#94A3B8" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="İndirmeyi Duraklat" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource IconPause}" Width="12" Height="12" Foreground="#38BDF8" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="İndirmeye Devam Et" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource IconResumeAll}" Width="12" Height="12" Foreground="#38BDF8" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Yeniden Başlat" Command="{Binding RestartCommand}">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource IconRestart}" Width="12" Height="12" Foreground="#F59E0B" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="İndirme Adresini Kopyala" Command="{Binding CopyUrlCommand}">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource IconCopy}" Width="12" Height="12" Foreground="#94A3B8" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="SHA-256 Değerini Kopyala" Command="{Binding CopySha256Command}" IsVisible="{Binding HasSha256}">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource IconHash}" Width="12" Height="12" Foreground="#34D399" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Güvenlik Raporunu Aç" Command="{Binding OpenSecurityReportCommand}" IsVisible="{Binding SecurityVerdict, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource IconShield}" Width="12" Height="12" Foreground="{Binding SecurityTextColor}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="İndirmeyi Sil..." Command="{Binding DeleteCommand}">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" Foreground="#EF4444" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid RowDefinitions="Auto,Auto,Auto">
                                        <!-- Layer 1 (Upper): File Name, Total Size, Status & Security Badges -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <!-- File Icon, Name and Total Size -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <PathIcon Data="{StaticResource IconFile}" Width="13" Height="13" Foreground="#64748B" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"
                                                           VerticalAlignment="Center" MaxWidth="560" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TotalSizeText}" FontSize="11" Foreground="#64748B"
                                                           VerticalAlignment="Center" Margin="2,0,0,0" />
                                            </StackPanel>

                                            <!-- Compact Status & Security Badges -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <!-- Minimal VirusTotal Security Badge -->
                                                <Button Command="{Binding OpenSecurityReportCommand}"
                                                        Background="{Binding SecurityBgColor}"
                                                        BorderBrush="{Binding SecurityBorderColor}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Cursor="Hand"
                                                        ToolTip.Tip="VirusTotal Güvenlik Raporu (Tıkla ve Aç)"
                                                        IsVisible="{Binding SecurityVerdict, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <PathIcon Data="{StaticResource IconShield}" Width="10" Height="10"
                                                                  Foreground="{Binding SecurityTextColor}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding SecurityBadgeText}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding SecurityTextColor}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Soft Pastel Status Badge -->
                                                <Border Background="{Binding StatusBgColor}"
                                                        BorderBrush="{Binding StatusBorderColor}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="7,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{Binding StatusTextColor}" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Slim & Elegant Progress Bar (3px) -->
                                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}"
                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                     Height="3" CornerRadius="1.5"
                                                     Background="#202026" Foreground="{Binding ProgressBarColor}"
                                                     Margin="0,8,0,8" />

                                        <!-- Layer 2 (Lower): Technical Details & Hover Actions -->
                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                            <!-- Left: Instantaneous Speed, Downloaded/Total, ETA, Connection Count -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <!-- Instantaneous Speed -->
                                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Text="↓" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SpeedText}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Text="•" Foreground="#272730" FontSize="11" VerticalAlignment="Center" />

                                                <!-- Downloaded / Total Amount -->
                                                <TextBlock Text="{Binding DownloadedAndTotalText}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />

                                                <!-- Percentage -->
                                                <TextBlock Text="{Binding ProgressPercentage, StringFormat={}({0:F1}%)}"
                                                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />

                                                <!-- Remaining Time (ETA) -->
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                                            IsVisible="{Binding EtaText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Text="•" Foreground="#272730" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding EtaText}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Connections / Chunks count -->
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                                            IsVisible="{Binding ConnectionsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Text="•" Foreground="#272730" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ConnectionsText}" FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Right: Actions (Dosyayı Aç, Durdur/Devam et, Klasörde Aç, Sil) -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <!-- Open File Action (Tamamlandığında doğrudan dosyayı açar) -->
                                                <Button Command="{Binding OpenFileCommand}" IsVisible="{Binding IsCompleted}"
                                                        Classes="row-action" ToolTip.Tip="Dosyayı Aç">
                                                    <PathIcon Data="{StaticResource IconFile}" Width="13" Height="13" Foreground="#38BDF8" />
                                                </Button>

                                                <!-- Pause Action (Net, dolgulu ve canlı duraklatma) -->
                                                <Button Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}"
                                                        Classes="row-action-primary" ToolTip.Tip="İndirmeyi Duraklat">
                                                    <PathIcon Data="{StaticResource IconPause}" Width="13" Height="13" Foreground="#38BDF8" />
                                                </Button>

                                                <!-- Resume Action (Canlı mavi/camgöbeği başlat ve devam et) -->
                                                <Button Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}"
                                                        Classes="row-action-primary" ToolTip.Tip="İndirmeyi Başlat / Devam Et">
                                                    <PathIcon Data="{StaticResource IconResumeAll}" Width="13" Height="13" Foreground="#38BDF8" />
                                                </Button>

                                                <!-- Open Folder Action -->
                                                <Button Command="{Binding OpenFolderCommand}"
                                                        Classes="row-action" ToolTip.Tip="Klasörde Göster">
                                                    <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" Foreground="#94A3B8" />
                                                </Button>

                                                <!-- Delete Action -->
                                                <Button Command="{Binding DeleteCommand}"
                                                        Classes="row-action" ToolTip.Tip="İndirmeyi Sil...">
                                                    <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" Foreground="#EF4444" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
