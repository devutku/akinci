<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Akinci.Application\Akinci.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" Version="55.1.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Paketleme ve Lisanslama -->
    <PackageId>Akinci.Infrastructure</PackageId>
    <Version>1.0.2</Version>
    <Authors>Utku Berki Baysal</Authors>
    <Company>Akıncı</Company>
    <Description>Akıncı Çok Kanallı İndirme Motoru HTTP/FTP/HLS protokol adaptörleri, SocketsHttpHandler ve SQLite kalıcılık katmanı.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/devutku/akinci</PackageProjectUrl>
    <RepositoryUrl>https://github.com/devutku/akinci.git</RepositoryUrl>
    <PackageTags>download-manager;downloader;chunk;resilient;hls;infrastructure</PackageTags>
  </PropertyGroup>

</Project>
